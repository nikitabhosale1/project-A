provider "aws" {
  region = "us-east-1" # Specify your AWS region
}

# S3 Bucket
resource "aws_s3_bucket" "my_bucket" {
  bucket = "my-sample-bucket"  # Replace with your unique bucket name
  acl    = "public-read"

  website {
    index_document = "index.html"
    error_document = "error.html"
  }

  tags = {
    Name        = "My S3 Bucket"
    Environment = "Development"
  }
}

# EC2 Instance
resource "aws_instance" "my_instance" {
  ami           = "ami-0c02fb55956c7d316"  # Replace with your region's AMI ID
  instance_type = "t2.micro"

  key_name      = "your-key-pair" # Replace with your key pair name
  security_groups = ["default"]  # Replace with your security group name

  tags = {
    Name = "My EC2 Instance"
  }
}

# RDS Instance
resource "aws_db_instance" "my_rds_instance" {
  allocated_storage    = 20
  engine               = "mysql"
  instance_class       = "db.t2.micro"
  name                 = "sampledb"
  username             = "admin"
  password             = "password123"  # Replace with a secure password
  publicly_accessible  = true
  skip_final_snapshot  = true

  tags = {
    Name = "My RDS Instance"
  }
}
